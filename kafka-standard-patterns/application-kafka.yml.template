spring:
  kafka:
    # 카프카 클러스터 브로커 주소 (콤마로 구분하여 다수 입력 가능)
    bootstrap-servers: [YOUR_KAFKA_BROKER_URL]
    
    consumer:
      # 컨슈머를 그룹으로 묶어 메시지를 분산 처리하게 함
      group-id: [YOUR_GROUP_ID]
      
      # 새 컨슈머 그룹이 처음 시작할 때, 가장 처음 오프셋부터 읽을지 결정 (earliest/latest)
      auto-offset-reset: earliest
      
      # 메시지 수신 후 자동으로 오프셋을 커밋할지 여부 (실무에선 수동 커밋 권장)
      enable-auto-commit: true 